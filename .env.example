# ---- 聊天模型：DeepSeek ----
# 不填 key 时会自动使用 mock 模型，方便先跑通界面和状态机。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---- 服务 ----
FATFISH_HOST=127.0.0.1
FATFISH_PORT=8080
FATFISH_TZ=Asia/Shanghai
FATFISH_BOT_NAME=茉莉
FATFISH_USER_NAME=你
FATFISH_DATA_DIR=private
FATFISH_MOCK_LLM=

# ---- 模型行为 ----
FATFISH_TEMPERATURE=0.8
FATFISH_MAX_TOKENS=900
FATFISH_RECENT_MESSAGES=30
FATFISH_MAX_CONTEXT_CHARS=12000
FATFISH_MAX_TOOL_ROUNDS=6
FATFISH_MAX_BURST=20
FATFISH_SCHEDULER_INTERVAL=30
FATFISH_MIN_THINK_MINUTES=5
FATFISH_MAX_THINK_MINUTES=720
FATFISH_PROACTIVE=1

# ---- TTS / ASR：SiliconFlow（主选）----
SILICONFLOW_API_KEY=
SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
SILICONFLOW_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
# references=每次带参考音频 + 文字稿；upload=用已上传的 voice URI
SILICONFLOW_TTS_MODE=references
SILICONFLOW_TTS_REFERENCE=private/voice/simple.mp3
SILICONFLOW_TTS_REFERENCE_TEXT=private/voice/simple.txt
SILICONFLOW_TTS_SPEED=0.8
SILICONFLOW_VOICE_FILE=private/voice/siliconflow_voice.json

# ---- TTS 备选：MiMo ----
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=茉莉
MIMO_CLONE_MODEL=mimo-v2.5-tts-voiceclone
# 可选：指定克隆参考音频；不填则自动找 private/voice/ 下的第一个音频
MIMO_VOICE_SAMPLE=private/voice/simple.mp3

# ---- TTS 备选：Breeze Blue ----
# 控制台创建 API key 后填入；语音档案在管理台「语音工作室」按用户克隆
BREEZE_API_KEY=
BREEZE_BASE_URL=https://api.breeze.blue
BREEZE_TTS_MODEL=breeze-tts-2
BREEZE_LANGUAGE_CODE=zh

# ---- QQ / OneBot 11（Windows 原生 NapCat）----
ONEBOT_ENABLED=1
# 你的 QQ 小号；只接受这个号的私聊
OWNER_QQ=
# 与 NapCat 反向 WS 的 token 保持一致；留空则本机不鉴权
ONEBOT_ACCESS_TOKEN=
# Windows 没把 ffmpeg 加进 PATH 时填绝对路径，例如 C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg
# 单条语音文本上限，超过会拆成多段
TTS_MAX_CHARS=300
# 模型本来发文字时，按此概率自动改发语音（0–1；0=不强制，1=全部转语音）
FATFISH_VOICE_PROBABILITY=0.2
